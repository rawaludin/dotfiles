#!/usr/bin/env bash
# Get osx battery level

print_battery_percentage() {
  # Ambil baris baterai: prioritaskan InternalBattery, fallback ke baris pertama yg ada %
  # (kalau ada UPS seperti Smart-UPS_1000, format kolomnya beda jadi $3 bukan persen lagi)
  line=`pmset -g batt | grep -E '[0-9]+%' | grep -m1 'InternalBattery' || pmset -g batt | grep -m1 -E '[0-9]+%'`
  percent=`echo "$line" | grep -o '[0-9]\+%' | head -1`
  # Deteksi charging via "; charging" / "; charged" supaya "not charging" (UPS) tidak ketipu
  if echo "$line" | grep -qE ';\s*charg(ed|ing)\b'; then
    echo " "$percent" [C]"
  else
    echo " "$percent
  fi
}

main() {
  print_battery_percentage
}

main
